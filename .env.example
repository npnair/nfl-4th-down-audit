# Which warehouse the loader, dbt, and dashboard use: postgres or bigquery
WAREHOUSE=postgres
DBT_TARGET=postgres

# Postgres (local development with docker compose)
DATABASE_URL=postgresql://nfl:nfl@localhost:5432/nfl

# BigQuery (authenticate first with: gcloud auth application-default login)
GCP_PROJECT=your-gcp-project-id
BQ_LOCATION=US
